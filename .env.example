# =============================================================================
# docker-compose / Traefik Settings
# =============================================================================

# Domain where the backend will be served
APP_DOMAIN=api.diary.minagiri.net

# Docker network shared with Traefik
TRAEFIK_DOCKER_NETWORK=traefik-network

# GitHub Pages Frontend URL (used for CORS and OAuth callback redirect)
FRONTEND_URL=https://nagi314.github.io/diary-beta-

# =============================================================================
# GitHub OAuth Settings
# =============================================================================
# Set these in backend/.env on the server (do NOT commit secrets)
# GITHUB_CLIENT_ID=your_client_id
# GITHUB_CLIENT_SECRET=your_client_secret
# GITHUB_CALLBACK_URL=https://api.diary.minagiri.net/auth/github/callback
